# MOADA development environment.
# Copy this file to .env (make env) and adjust values as needed.
# Never commit the real .env file.

# development | test | production
MOADA_ENV=development
MOADA_HTTP_ADDR=:8080
# debug | info | warn | error
MOADA_LOG_LEVEL=debug

# PostgreSQL
MOADA_DATABASE_URL=postgres://moada:moada@localhost:5434/moada?sslmode=disable
MOADA_DB_MAX_CONNS=10
MOADA_DB_CONNECT_TIMEOUT=10s

# Garage (S3-compatible object storage)
# Development-only credentials. They match deploy/garage/garage.toml and
# deploy/docker-compose.yml and must be replaced in production.
MOADA_S3_ENDPOINT=localhost:3900
MOADA_S3_ACCESS_KEY=GK7f3a9c2e5b1d8f4a6c0e9b3d7a1f5c8e
MOADA_S3_SECRET_KEY=db13155a608a27bf48a39b1d0ca781fd0f6bac4728535be440a8a08a2ad20dee
MOADA_S3_BUCKET=moada-dev
MOADA_S3_REGION=garage
MOADA_S3_USE_SSL=false
MOADA_S3_CREATE_BUCKET=true

# Local development infrastructure (deploy/docker-compose.yml)
POSTGRES_DB=moada
POSTGRES_USER=moada
POSTGRES_PASSWORD=moada
POSTGRES_PORT=5434
