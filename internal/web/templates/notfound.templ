package templates

templ NotFoundPage() {
	@Layout("Página não encontrada — MOADA", notFoundContent())
}

templ notFoundContent() {
	<div>
		<header>
			<a href="/">MOADA</a>
		</header>
		<main>
			<h1>Página não encontrada</h1>
			<p>O endereço acessado não existe.</p>
			<p><a href="/">Voltar para o início</a></p>
		</main>
	</div>
}
